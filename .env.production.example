# Copy this to .env on the server and fill in all values.
# Never commit the real .env to git.

# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-strong-random-string

# PostgreSQL password (choose a strong one)
POSTGRES_PASSWORD=change-me-db-password

# Your server's public IP or domain (no trailing slash)
# Example with IP:     http://165.22.100.200
# Example with domain: https://app.continuity.com
VITE_API_URL=http://YOUR_SERVER_IP_OR_DOMAIN
CORS_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
