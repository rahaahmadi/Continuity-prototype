# Continuity API – copy to .env and adjust

# Database (async driver for the app)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/continuity

# Auth – set a strong secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS – comma-separated origins (e.g. your frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional
DEBUG=false
APP_NAME=Continuity API
